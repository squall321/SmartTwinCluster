offline_packages_2404/dist/stc-offline-*/

# 부트스트랩 필수 wheel (작아서 git 트래킹) — install_services.sh 가 직접 경로로 호출
!offline_packages_2404/python_wheels/python3.12/setuptools-*.whl
!offline_packages_2404/python_wheels/python3.12/wheel-*.whl
!offline_packages_2404/python_wheels/python3.13/setuptools-*.whl
!offline_packages_2404/python_wheels/python3.13/wheel-*.whl
!offline_packages_2404/python_wheels/python3.12/packaging-*.whl
!offline_packages_2404/python_wheels/python3.13/packaging-*.whl
# SAML 인증용 — manylinux 자체번들 wheel (sdist 빌드 회피, ABI 정합)
!offline_packages_2404/python_wheels/python3.12/xmlsec-*.whl
!offline_packages_2404/python_wheels/python3.12/lxml-6*.whl
dashboard/prometheus_9090/.prometheus.pid
**/.prometheus.pid

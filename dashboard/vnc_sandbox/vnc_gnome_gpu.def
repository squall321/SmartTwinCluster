Bootstrap: docker
From: ubuntu:22.04

# ============================================================================
# VNC GNOME Desktop + VirtualGL (GPU 가속 OpenGL) — Ubuntu 22.04 (light, CUDA 없음)
# ----------------------------------------------------------------------------
# 기존 vnc_gnome.sif(GNOME) + xfce GPU(vnc_desktop_gpu.def)의 검증된 부분을 결합:
#   - GNOME 데스크톱 (gnome-session/shell/terminal/nautilus)
#   - TigerVNC + noVNC + VirtualGL (vglrun: GL 앱을 GPU 렌더)
#   - start_vnc_gnome.sh 를 xfce GPU 와 동일한 '검증된' 방식으로 생성:
#       Xtigervnc -SecurityTypes None (옛 vncserver+비번 방식 X — noVNC 파이프라인/
#       블랙리스트 수정과 호환되는 방식), VGL_DISPLAY=egl, exec gnome-session.
#
# 런타임 전제:
#   - gpu_count>0 → backend 가 --nv 추가(호스트 드라이버/EGL 주입). --nv 없으면 GPU 미사용.
#   - GNOME Shell 자체는 VNC X서버(소프트웨어 GL)로 뜨고, GL 앱만 vglrun(-d egl)로 GPU.
#   - GL 앱: vgl <app>  또는  vglrun -d egl <app>   검증: vgl glxinfo | grep "OpenGL renderer"
# ============================================================================

%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Seoul

    apt-get update && apt-get upgrade -y
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

    apt-get install -y \
        wget curl git vim nano \
        ca-certificates gnupg lsb-release \
        software-properties-common \
        locales tzdata

    locale-gen en_US.UTF-8
    update-locale LANG=en_US.UTF-8

    # ---- GNOME 데스크톱 (gdm3 디스플레이매니저는 컨테이너에 불필요 → 핵심만) ----
    apt-get install -y \
        gnome-session gnome-shell \
        gnome-terminal gnome-control-center \
        nautilus gnome-tweaks \
        gnome-shell-extension-prefs \
        dbus-x11 x11-utils x11-xserver-utils \
        adwaita-icon-theme yaru-theme-gnome-shell fonts-dejavu

    # VNC Server (TigerVNC)
    apt-get install -y \
        tigervnc-standalone-server \
        tigervnc-common \
        tigervnc-tools

    # noVNC + websockify
    apt-get install -y \
        python3 python3-pip python3-numpy \
        novnc websockify

    # GPU 테스트/시각화 도구
    apt-get install -y \
        mesa-utils \
        glmark2 \
        vulkan-tools

    # ---- VirtualGL 의존 라이브러리 (EGL/GLX 로더 + GL 스택) ----
    # 실제 nvidia EGL/GLX 구현체는 런타임에 --nv 로 주입됨.
    apt-get install -y \
        libegl1 libgl1 libglx-mesa0 libgles2 \
        libglu1-mesa libglvnd0 \
        libxv1 libxtst6 libxcb-keysyms1

    # ---- VirtualGL 설치 (Ubuntu 기본 repo 에 없음 → 프로젝트 .deb) ----
    VGL_VER=3.1
    cd /tmp
    if ls /tmp/virtualgl_*_amd64.deb >/dev/null 2>&1; then
        echo "Installing VirtualGL from staged .deb"
        dpkg -i /tmp/virtualgl_*_amd64.deb || apt-get install -f -y
    else
        echo "Downloading VirtualGL ${VGL_VER} from GitHub releases"
        wget -q "https://github.com/VirtualGL/virtualgl/releases/download/${VGL_VER}/virtualgl_${VGL_VER}_amd64.deb" \
            && dpkg -i "virtualgl_${VGL_VER}_amd64.deb" || apt-get install -f -y
    fi
    rm -f /tmp/virtualgl_*.deb || true
    /opt/VirtualGL/bin/vglrun --help >/dev/null 2>&1 && echo "VirtualGL OK" || echo "WARN: VirtualGL 설치 확인 실패"

    # 웹 브라우저 / 파일도구 / 네트워크도구
    apt-get install -y firefox file-roller gedit \
        net-tools iputils-ping openssh-client

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    mkdir -p /root/.vnc /tmp/.X11-unix /opt/scripts
    chmod 1777 /tmp/.X11-unix || true

    # ---- /opt/scripts/start_vnc_gnome.sh 생성 (backend 가 호출하는 진입점) ----
    cat > /opt/scripts/start_vnc_gnome.sh << 'STARTVNC_EOF'
#!/bin/bash
# VNC + GNOME 시작 스크립트 (GPU/VirtualGL 빌드) — xfce GPU 와 동일한 검증된 방식
unset DBUS_SESSION_BUS_ADDRESS
unset DBUS_SESSION_BUS_PID

DISPLAY_NUM=${1:-1}
export DISPLAY=:${DISPLAY_NUM}
export XAUTHORITY=/root/.Xauthority
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=GNOME
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p $XDG_RUNTIME_DIR

# VirtualGL: EGL 백엔드(headless GPU). GL 앱은 vglrun 으로 실행하면 GPU 렌더.
export VGL_DISPLAY=egl
export PATH=/opt/VirtualGL/bin:$PATH
# GNOME Shell 이 VNC X서버(소프트웨어 GL)로 안정적으로 뜨게
export GDK_BACKEND=x11

echo "Starting Xtigervnc on display :${DISPLAY_NUM}"
Xtigervnc :${DISPLAY_NUM} \
    -geometry ${VNC_GEOMETRY:-1920x1080} \
    -depth 24 \
    -rfbport ${VNC_PORT:-5900} \
    -SecurityTypes None \
    -AlwaysShared \
    -AcceptKeyEvents \
    -AcceptPointerEvents \
    -AcceptSetDesktopSize \
    -SendCutText \
    -AcceptCutText \
    -desktop "VNC Desktop" \
    -localhost no \
    > /tmp/Xtigervnc_${DISPLAY_NUM}.log 2>&1 &
VNC_PID=$!
echo "Xtigervnc started with PID: $VNC_PID"

sleep 3

echo "Starting new DBUS session for GNOME"
eval $(dbus-launch --sh-syntax)
export DBUS_SESSION_BUS_ADDRESS
export DBUS_SESSION_BUS_PID

echo "Starting GNOME session"
exec gnome-session
STARTVNC_EOF
    chmod +x /opt/scripts/start_vnc_gnome.sh

    # GL 앱을 GPU 로 띄우는 헬퍼
    cat > /usr/local/bin/vgl << 'VGL_EOF'
#!/bin/bash
exec /opt/VirtualGL/bin/vglrun -d egl "$@"
VGL_EOF
    chmod +x /usr/local/bin/vgl

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    export PATH=/opt/VirtualGL/bin:/usr/local/nvidia/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:$LD_LIBRARY_PATH
    export VGL_DISPLAY=egl
    export XDG_RUNTIME_DIR=/tmp/runtime-root

%runscript
    echo "VNC GNOME Desktop + VirtualGL (GPU) Environment"
    echo "  Start: /opt/scripts/start_vnc_gnome.sh <display_num>   (backend 가 호출)"
    echo "  GPU GL 앱:  vgl <app>   또는   vglrun -d egl <app>"

%labels
    Author koopark
    Version 1.0-gpu
    Description VNC GNOME Desktop + VirtualGL(EGL) GPU-accelerated OpenGL for HPC viz

%help
    GPU 가속 VNC GNOME 데스크톱 (TigerVNC + VirtualGL EGL).
    런타임에 --nv 필요(gpu_count>0). GL 앱은 vglrun(-d egl) 으로 실행.

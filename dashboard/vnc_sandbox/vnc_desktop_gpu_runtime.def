Bootstrap: docker
From: nvidia/cuda:11.8.0-runtime-ubuntu22.04

# ============================================================================
# VNC Desktop + VirtualGL (GPU 가속 OpenGL) — Ubuntu 22.04 (runtime CUDA, 슬림)
# ----------------------------------------------------------------------------
# 기존 vnc_desktop.def 와 동일한 XFCE4 + TigerVNC + noVNC 스택에
#   - VirtualGL (vglrun: GL 앱을 GPU 에서 렌더 후 VNC 화면으로 전송)
#   - EGL 백엔드용 라이브러리 (headless GPU, 별도 GPU X서버 불필요)
#   - /opt/scripts/start_vnc.sh 를 빌드시 직접 생성(재현성)
# 를 추가한 GPU 버전.
#
# 사용 전제(런타임):
#   - 잡 제출 시 gpu_count>0 → backend 가 apptainer instance start 에 --nv 추가
#     (--nv 가 nvidia 드라이버/EGL 라이브러리를 컨테이너로 주입). --nv 없으면 GPU 미사용.
#   - GL 앱은 vglrun 으로 실행: 예)  vglrun -d egl glxinfo | grep "OpenGL renderer"
#     → NVIDIA ... 가 보이면 GPU 렌더 성공 (llvmpipe 면 소프트웨어).
# ============================================================================

%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Asia/Seoul

    apt-get update && apt-get upgrade -y
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

    # 기본 유틸리티
    apt-get install -y \
        wget curl git vim nano \
        ca-certificates gnupg lsb-release \
        software-properties-common \
        locales tzdata

    locale-gen en_US.UTF-8
    update-locale LANG=en_US.UTF-8

    # 경량 데스크톱 (XFCE4)
    apt-get install -y \
        xfce4 xfce4-goodies \
        xfce4-terminal thunar \
        dbus-x11 x11-utils x11-xserver-utils

    # VNC Server (TigerVNC)
    apt-get install -y \
        tigervnc-standalone-server \
        tigervnc-common \
        tigervnc-tools

    # noVNC + websockify
    apt-get install -y \
        python3 python3-pip python3-numpy \
        novnc websockify

    # GPU 테스트/시각화 도구
    apt-get install -y \
        mesa-utils \
        glmark2 \
        vulkan-tools

    # ---- VirtualGL 의존 라이브러리 (EGL/GLX 로더 + GL 스택) ----
    # 실제 nvidia EGL/GLX 구현체는 런타임에 --nv 로 주입됨. 여기선 로더/헤더만.
    apt-get install -y \
        libegl1 libgl1 libglx-mesa0 libgles2 \
        libglu1-mesa libglvnd0 \
        libxv1 libxtst6 libxcb-keysyms1

    # ---- VirtualGL 설치 (Ubuntu 기본 repo 에 없음 → 프로젝트 .deb) ----
    # 온라인 빌드: wget 로 받음.
    # 오프라인 빌드: 빌드 전에 virtualgl_${VGL_VER}_amd64.deb 를 /tmp 에 두면 그걸 우선 사용.
    #   (build_vnc_gpu_sandbox.sh 가 --bind 로 호스트의 .deb 를 /tmp 에 넣어줌)
    VGL_VER=3.1
    cd /tmp
    if ls /tmp/virtualgl_*_amd64.deb >/dev/null 2>&1; then
        echo "Installing VirtualGL from staged .deb"
        dpkg -i /tmp/virtualgl_*_amd64.deb || apt-get install -f -y
    else
        echo "Downloading VirtualGL ${VGL_VER} from GitHub releases"
        wget -q "https://github.com/VirtualGL/virtualgl/releases/download/${VGL_VER}/virtualgl_${VGL_VER}_amd64.deb" \
            && dpkg -i "virtualgl_${VGL_VER}_amd64.deb" || apt-get install -f -y
    fi
    rm -f /tmp/virtualgl_*.deb || true
    # 설치 확인 (실패해도 빌드는 계속 — 런타임 로그로 확인)
    /opt/VirtualGL/bin/vglrun --help >/dev/null 2>&1 && echo "VirtualGL OK" || echo "WARN: VirtualGL 설치 확인 실패"

    # 웹 브라우저 / 파일도구 / 네트워크도구
    apt-get install -y firefox file-roller gedit \
        net-tools iputils-ping openssh-client

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # VNC 디렉토리
    mkdir -p /root/.vnc /tmp/.X11-unix /opt/scripts
    chmod 1777 /tmp/.X11-unix || true

    # ---- /opt/scripts/start_vnc.sh 생성 (backend 가 호출하는 진입점) ----
    # 따옴표친 heredoc('STARTVNC_EOF') → ${VNC_PORT} 등은 런타임에 평가(빌드시 X).
    cat > /opt/scripts/start_vnc.sh << 'STARTVNC_EOF'
#!/bin/bash
# VNC + XFCE4 시작 스크립트 (GPU/VirtualGL 빌드)
# 호스트 DBUS 환경변수 제거 (가장 중요!)
unset DBUS_SESSION_BUS_ADDRESS
unset DBUS_SESSION_BUS_PID

DISPLAY_NUM=${1:-1}
export DISPLAY=:${DISPLAY_NUM}
export XAUTHORITY=/root/.Xauthority
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p $XDG_RUNTIME_DIR

# VirtualGL: EGL 백엔드(headless GPU). GL 앱은 vglrun 으로 실행하면 GPU 렌더.
export VGL_DISPLAY=egl
export PATH=/opt/VirtualGL/bin:$PATH

echo "Starting Xtigervnc on display :${DISPLAY_NUM}"
Xtigervnc :${DISPLAY_NUM} \
    -geometry ${VNC_GEOMETRY:-1920x1080} \
    -depth 24 \
    -rfbport ${VNC_PORT:-5900} \
    -SecurityTypes None \
    -AlwaysShared \
    -AcceptKeyEvents \
    -AcceptPointerEvents \
    -AcceptSetDesktopSize \
    -SendCutText \
    -AcceptCutText \
    -desktop "VNC Desktop" \
    -localhost no \
    > /tmp/Xtigervnc_${DISPLAY_NUM}.log 2>&1 &
VNC_PID=$!
echo "Xtigervnc started with PID: $VNC_PID"

sleep 3

echo "Starting new DBUS session for XFCE4"
eval $(dbus-launch --sh-syntax)
export DBUS_SESSION_BUS_ADDRESS
export DBUS_SESSION_BUS_PID

echo "Starting XFCE4 session"
exec xfce4-session
STARTVNC_EOF
    chmod +x /opt/scripts/start_vnc.sh

    # GL 앱을 GPU 로 띄우는 헬퍼 (데스크톱 터미널에서: vgl <app>)
    cat > /usr/local/bin/vgl << 'VGL_EOF'
#!/bin/bash
# GPU 가속으로 GL 앱 실행: vgl <app> [args...]
exec /opt/VirtualGL/bin/vglrun -d egl "$@"
VGL_EOF
    chmod +x /usr/local/bin/vgl

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    export PATH=/opt/VirtualGL/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:$LD_LIBRARY_PATH
    export VGL_DISPLAY=egl
    export XDG_RUNTIME_DIR=/tmp/runtime-root

%runscript
    echo "VNC Desktop + VirtualGL (GPU) Environment"
    echo "  Start: /opt/scripts/start_vnc.sh <display_num>   (backend 가 호출)"
    echo "  GPU GL 앱:  vgl <app>   또는   vglrun -d egl <app>"
    echo "  검증:  vglrun -d egl glxinfo | grep 'OpenGL renderer'"

%labels
    Author koopark
    Version 1.0-gpu
    Description VNC Desktop + VirtualGL(EGL) GPU-accelerated OpenGL for HPC viz

%help
    GPU 가속 VNC 데스크톱 (TigerVNC + VirtualGL EGL 백엔드).
    런타임에 --nv 필요(gpu_count>0). GL 앱은 vglrun(-d egl) 으로 실행.

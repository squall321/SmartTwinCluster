# ============================================================================
# Dashboard Backend (5010) Environment Variables
# ============================================================================
# Generated from web_services_config.yaml
# Environment: development
# ============================================================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5010

# JWT Configuration (must match Auth Portal)
JWT_SECRET_KEY=Soseks314!
JWT_ALGORITHM=HS256

# Slurm Configuration
SLURM_CONTROL_NODE=gpu-master
SLURM_PARTITION_CPU=compute
SLURM_PARTITION_GPU=gpu
# Slurm 명령어 경로 (sinfo, scontrol 등)
# - apt/yum 패키지: /usr/bin
# - 소스 빌드 (기본값): /usr/local/slurm/bin (Slurm 23.11.10)
SLURM_BIN_DIR=/usr/local/slurm/bin

# Monitoring URLs
PROMETHEUS_URL=http://localhost:9090
NODE_EXPORTER_URL=http://localhost:9100

# WebSocket URL
WEBSOCKET_URL=ws://localhost:5011/ws

# VNC API URL
VNC_API_URL=http://localhost:5010/api/vnc

# Logging
LOG_LEVEL=DEBUG

# Mode Configuration
MOCK_MODE=false

# Database Configuration
# SQLite database for apptainer images, templates, etc.
DATABASE_PATH=/home/koopark/web_services/backend/dashboard.db

# Apptainer Configuration
# APPTAINER_REGISTRY: GlusterFS 기반 중앙 메타데이터 저장소
# APPTAINER_METADATA_DIR: JSON 메타데이터 디렉토리
# APPTAINER_RUNTIME_PATH: 실제 .sif 파일이 배포되는 경로 (compute/viz 노드)
APPTAINER_REGISTRY=/mnt/gluster/apptainer
APPTAINER_METADATA_DIR=/mnt/gluster/apptainer/metadata
APPTAINER_RUNTIME_PATH=/opt/apptainers

# Redis Configuration for Session Management
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Soseks314!
DEFAULT_SESSION_TTL=7200

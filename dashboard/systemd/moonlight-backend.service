[Unit]
Description=HPC Moonlight Backend (Gunicorn)
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=koopark
Group=koopark
WorkingDirectory=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004
Environment="PATH=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/venv/bin:/usr/local/slurm/bin:/usr/bin:/bin"
Environment="HOME=/home/koopark"
Environment="SLURM_BIN_DIR=/usr/local/slurm/bin"
EnvironmentFile=-/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/.env
ExecStart=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/venv/bin/gunicorn -c gunicorn_config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Logging
StandardOutput=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/logs/gunicorn.log
StandardError=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/logs/gunicorn_error.log

[Install]
WantedBy=multi-user.target

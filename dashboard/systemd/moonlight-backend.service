[Unit]
Description=HPC Moonlight Backend (Gunicorn)
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=__SERVICE_USER__   # placeholder — install_services.sh가 동적 치환
Group=__SERVICE_GROUP__
WorkingDirectory=__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004
Environment="PATH=__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/venv/bin:/usr/local/slurm/bin:/usr/bin:/bin"
Environment="HOME=/home/koopark"
Environment="SLURM_BIN_DIR=/usr/local/slurm/bin"
EnvironmentFile=-__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/.env
ExecStart=__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/venv/bin/gunicorn -c gunicorn_config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Logging
StandardOutput=append:__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/logs/gunicorn.log
StandardError=append:__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/MoonlightSunshine_8004/backend_moonlight_8004/logs/gunicorn_error.log

[Install]
WantedBy=multi-user.target

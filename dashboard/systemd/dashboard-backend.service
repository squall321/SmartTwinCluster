[Unit]
Description=HPC Dashboard Backend (Gunicorn)
After=network.target redis.service auth-backend.service
Wants=redis.service

[Service]
Type=simple
User=koopark
Group=koopark
WorkingDirectory=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/backend_5010
Environment="PATH=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/backend_5010/venv/bin"
EnvironmentFile=-/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/backend_5010/.env
ExecStart=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/backend_5010/venv/bin/gunicorn -c gunicorn_config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Logging
StandardOutput=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/backend_5010/logs/gunicorn.log
StandardError=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/backend_5010/logs/gunicorn_error.log

[Install]
WantedBy=multi-user.target

[Unit]
Description=HPC Auth Backend (Gunicorn)
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=koopark
Group=koopark
WorkingDirectory=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/auth_portal_4430
Environment="PATH=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/auth_portal_4430/venv/bin:/usr/local/slurm/bin:/usr/bin:/bin"
Environment="HOME=/home/koopark"
Environment="SLURM_BIN_DIR=/usr/local/slurm/bin"
EnvironmentFile=-/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/auth_portal_4430/.env
ExecStart=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/auth_portal_4430/venv/bin/gunicorn -c gunicorn_config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Logging
StandardOutput=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/auth_portal_4430/logs/gunicorn.log
StandardError=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/auth_portal_4430/logs/gunicorn_error.log

[Install]
WantedBy=multi-user.target

[Unit]
Description=HPC WebSocket Server
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=__SERVICE_USER__   # placeholder — install_services.sh가 동적 치환
Group=__SERVICE_GROUP__
WorkingDirectory=__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/websocket_5011
Environment="PATH=__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/websocket_5011/venv/bin:/usr/local/slurm/bin:/usr/bin:/bin"
Environment="HOME=/home/koopark"
Environment="SLURM_BIN_DIR=/usr/local/slurm/bin"
EnvironmentFile=-__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/websocket_5011/.env
ExecStart=__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/websocket_5011/venv/bin/python websocket_server_enhanced.py
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Logging
StandardOutput=append:__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/websocket_5011/logs/websocket.log
StandardError=append:__PROJECT_HOME__/claude/KooSlurmInstallAutomationRefactory/dashboard/websocket_5011/logs/websocket_error.log

[Install]
WantedBy=multi-user.target

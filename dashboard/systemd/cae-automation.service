[Unit]
Description=HPC CAE Automation Backend (Gunicorn)
After=network.target redis.service cae-backend.service
Wants=redis.service

[Service]
Type=notify
User=koopark
Group=koopark
WorkingDirectory=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/kooCAEWebAutomationServer_5001
Environment="PATH=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/kooCAEWebAutomationServer_5001/venv/bin"
EnvironmentFile=-/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/kooCAEWebAutomationServer_5001/.env
ExecStart=/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/kooCAEWebAutomationServer_5001/venv/bin/gunicorn -c gunicorn_config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Logging
StandardOutput=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/kooCAEWebAutomationServer_5001/logs/gunicorn.log
StandardError=append:/home/koopark/claude/KooSlurmInstallAutomationRefactory/dashboard/kooCAEWebAutomationServer_5001/logs/gunicorn_error.log

[Install]
WantedBy=multi-user.target

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "post_analyze args",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target"
  ],
  "properties": {
    "options": {
      "type": "object",
      "properties": {
        "deep_only": {
          "type": "boolean",
          "description": "--deep-only — deep report 만"
        },
        "sphere_only": {
          "type": "boolean",
          "description": "--sphere-only — sphere report 만 (DROP 전각도 강제)"
        },
        "impact_only": {
          "type": "boolean",
          "description": "--impact-only — impact report 만 (IMPACT 부분충격 DOE 강제)"
        },
        "force": {
          "type": "boolean",
          "description": "--force — 기존 결과 무시하고 전체 재계산"
        },
        "no_schema_check": {
          "type": "boolean",
          "description": "--no-schema-check — 산출물이 낡아도 재분석하지 않음"
        },
        "config": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--config X — unified_analyzer 용 YAML 경로(객체를 주면 YAML 로 만들어 올린다) (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "deep_config": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--deep-config X — koo_deep_report 용 YAML (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "threads": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--threads X — 병렬 스레드 수 (기본 4) (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "yield_stress": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--yield-stress X — 항복응력 MPa (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "no_render": {
          "type": "boolean",
          "description": "--no-render — 렌더 끔"
        },
        "per_part_render": {
          "type": "boolean",
          "description": "--per-part-render — 파트별 렌더"
        },
        "element_quality": {
          "type": "boolean",
          "description": "--element-quality — 요소 품질 분석"
        },
        "render_threads": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--render-threads X — 렌더 스레드 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "ua_threads": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--ua-threads X — unified_analyzer 스레드 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "parts": {
          "type": [
            "array",
            "string",
            "number"
          ],
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "--parts X — 파트 ID 목록"
        },
        "part_pattern": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--part-pattern X — 파트 패턴 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "strain_limit": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--strain-limit X — 변형률 한계 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "design_overrides": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--design-overrides X — 설계 기준 JSON (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "material_overrides": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--material-overrides X — 재료 기준 JSON (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "section_view": {
          "type": "boolean",
          "description": "--section-view — 단면뷰"
        },
        "section_view_backend": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--section-view-backend X — lsprepost|software (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "section_view_mode": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--section-view-mode X — section|section_3d (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "section_view_per_part": {
          "type": "boolean",
          "description": "--section-view-per-part — 파트별 단면뷰"
        },
        "section_view_axes": {
          "type": [
            "array",
            "string",
            "number"
          ],
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "--section-view-axes X — x y z"
        },
        "section_view_fields": {
          "type": [
            "array",
            "string",
            "number"
          ],
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "--section-view-fields X — von_mises eps strain …"
        },
        "section_view_target_ids": {
          "type": [
            "array",
            "string",
            "number"
          ],
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "--section-view-target-ids X — 대상 파트 ID"
        },
        "section_view_target_patterns": {
          "type": [
            "array",
            "string",
            "number"
          ],
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "--section-view-target-patterns X — 대상 파트 패턴"
        },
        "section_view_fade": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--section-view-fade X — 페이드 거리 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "sv_threads": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--sv-threads X — 단면뷰 스레드 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "deep_opts": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--deep-opts X — koo_deep_report 추가 옵션 문자열 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "sphere_opts": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--sphere-opts X — koo_sphere_report 추가 옵션 문자열 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "scatter": {
          "type": "boolean",
          "description": "--scatter — 각도 산포 리포트도 생성"
        },
        "scatter_opts": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--scatter-opts X — koo_scatter_report 옵션 문자열 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        },
        "impact_opts": {
          "type": [
            "string",
            "number",
            "integer",
            "object"
          ],
          "description": "--impact-opts X — koo_impact_report 옵션 문자열 (객체를 주면 YAML 파일로 만들어 넘긴다)"
        }
      },
      "additionalProperties": false,
      "description": "명령줄 옵션. 키는 --옵션 이름(밑줄·하이픈 모두 됨), 켜는 옵션은 true. --install-dir·--ua 처럼 실행 파일 위치를 바꾸는 옵션은 받지 않는다."
    },
    "argv_extra": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "description": "그대로 덧붙일 인자(드물게). 같은 금지 규칙과 경로 검사를 받는다."
    },
    "in_place": {
      "type": "boolean",
      "default": true,
      "description": "true 면 target 폴더(파일이면 그 폴더)에서 실행해 산출물이 결과 옆에 생긴다. false 면 잡 결과 폴더 work/ 에서 실행."
    },
    "target": {
      "type": "string",
      "pattern": "^/.+",
      "description": "분석할 폴더 절대경로 — /data/single/<사용자>/ 아래만"
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "description": "잡 자원(선택). 생략하면 도구 종류별 기본(전처리 2 CPU·8G, 후처리 4 CPU·16G, 24시간)을 클러스터에서 가장 큰 노드에 맞춰 줄여 쓴다.",
      "properties": {
        "cpus_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "CPU 수"
        },
        "mem": {
          "type": "string",
          "pattern": "^[0-9]{1,6}[MG]$",
          "description": "메모리 (예: 32G)"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
          "description": "시간 상한 HH:MM:SS"
        },
        "partition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "description": "파티션 이름 (생략 = 클러스터 기본)"
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "true 면 제출하지 않고 생성될 입력 파일·명령만 돌려준다(PAT 없이도 된다). 먼저 이걸로 확인할 것."
    },
    "wait_sec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800,
      "default": 0,
      "description": "제출 후 이 시간(초) 안에 끝나면 결과(rc·로그 꼬리·작은 산출물)를 함께 돌려준다. 0 = job_id 만."
    },
    "job_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,48}$",
      "description": "잡 이름(결과 폴더 이름이 된다). 생략하면 stmc_<도구이름>."
    }
  }
}

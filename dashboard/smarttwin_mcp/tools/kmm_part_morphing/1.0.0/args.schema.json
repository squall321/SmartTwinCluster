{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kmm_part_morphing args",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_path"
  ],
  "properties": {
    "model_path": {
      "type": "string",
      "pattern": "^/.+",
      "description": "입력 LS-DYNA 모델(.k) 절대경로. 잡 work/ 폴더로 복사돼 *Inputfile 이 된다."
    },
    "options": {
      "type": "object",
      "properties": {
        "*UnitScale": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 1.0 — 좌표 배율"
        },
        "*MeshSize": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 끔 — 지정 시 재메시"
        },
        "*MorphBox": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "위 형식 · 기본 - — 박스 영역 모핑. 변위 양수 = Pull, 음수 = Push (파서 기준, 크기는 절댓값)"
        },
        "*MorphfromPIDBox": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "위 형식 · 기본 - — 박스PID 파트의 bbox 를 박스로 사용 (0 이나 자기 자신이면 대상 파트 bbox)"
        },
        "*MorphPID": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "- · 기본 - — 파트 전체 모핑"
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "array"
        ]
      },
      "description": "블록 안 `키,값` 줄. 값이 배열이면 쉼표로 잇는다(예: [0,0,10] → 0,0,10). 아래 키 표에 없는 키(DropContact.<필드> 등)도 그대로 쓸 수 있다."
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 2000,
      "description": "블록에 그대로 넣을 원문 줄(같은 키 반복·*로 시작하는 줄·표). 사례 블록을 그대로 옮기면 된다. 빈 줄·**/*Mode/*End 줄은 넣을 수 없다."
    },
    "extra_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/.+"
      },
      "maxItems": 64,
      "description": "옵션이 가리키는 보조 파일의 절대경로. 잡 work/ 폴더로 같이 올라가므로 옵션 값에는 파일 이름만 쓰면 된다. 허용 범위: /data/single/<사용자>/, /shared/uploads/users/<사용자>/, /data/scenario/."
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "description": "잡 자원(선택). 생략하면 도구 종류별 기본(전처리 2 CPU·8G, 후처리 4 CPU·16G, 24시간)을 클러스터에서 가장 큰 노드에 맞춰 줄여 쓴다.",
      "properties": {
        "cpus_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "CPU 수"
        },
        "mem": {
          "type": "string",
          "pattern": "^[0-9]{1,6}[MG]$",
          "description": "메모리 (예: 32G)"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
          "description": "시간 상한 HH:MM:SS"
        },
        "partition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "description": "파티션 이름 (생략 = 클러스터 기본)"
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "true 면 제출하지 않고 생성될 입력 파일·명령만 돌려준다(PAT 없이도 된다). 먼저 이걸로 확인할 것."
    },
    "wait_sec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800,
      "default": 0,
      "description": "제출 후 이 시간(초) 안에 끝나면 결과(rc·로그 꼬리·작은 산출물)를 함께 돌려준다. 0 = job_id 만."
    },
    "job_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,48}$",
      "description": "잡 이름(결과 폴더 이름이 된다). 생략하면 stmc_<도구이름>."
    }
  }
}

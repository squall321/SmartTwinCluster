{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "maxLength": 200,
      "description": "찾을 낱말(이름·요약·설명·태그·도구에 모두 들어 있는 것)"
    },
    "tool": {
      "type": "string",
      "maxLength": 64,
      "description": "대상 도구로 거르기(예: kmm_chain)"
    },
    "include_retired": {
      "type": "boolean",
      "default": false,
      "description": "내려진 판까지 보기"
    }
  }
}

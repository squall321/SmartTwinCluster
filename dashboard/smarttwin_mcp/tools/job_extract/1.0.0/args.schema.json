{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "registry_id"
      ]
    },
    {
      "required": [
        "job_id"
      ]
    },
    {
      "required": [
        "work_dir"
      ]
    }
  ],
  "properties": {
    "registry_id": {
      "type": "integer",
      "minimum": 1,
      "description": "캠페인 제출 응답의 registry_id"
    },
    "job_id": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]{1,12}$",
      "minimum": 1,
      "description": "캠페인 드라이버 잡의 Slurm job_id"
    },
    "work_dir": {
      "type": "string",
      "pattern": "^/.+",
      "description": "캠페인 결과 폴더 절대경로(/data/single/<사용자>/ 아래)"
    },
    "case_key": {
      "type": "string",
      "pattern": "^Run_[A-Za-z0-9_]+$",
      "description": "Run 폴더 이름(Run_<시각>_<해시>) — job_status runs:true 의 case_key"
    },
    "spec": {
      "type": "string",
      "pattern": "^/.+\\.json$",
      "description": "필수 추출 목록 JSON(설정 대신) — 호출자 영역 안"
    }
  },
  "required": [
    "case_key"
  ]
}

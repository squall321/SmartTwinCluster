{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [{"required": ["registry_id"]}, {"required": ["job_id"]}, {"required": ["work_dir"]}],
  "properties": {
    "registry_id": {"type": "integer", "minimum": 1, "description": "제출 응답의 registry_id"},
    "job_id": {"type": ["string", "integer"], "pattern": "^[0-9]{1,12}$", "minimum": 1, "description": "제출 응답의 Slurm job_id"},
    "work_dir": {"type": "string", "pattern": "^/.+", "description": "결과 폴더 절대경로(제출 응답의 result_dir, /data/single/<사용자>/ 아래)"},
    "wait_sec": {"type": "integer", "minimum": 0, "maximum": 1800, "default": 0, "description": "끝날 때까지 기다릴 최대 시간(초)"}
  }
}

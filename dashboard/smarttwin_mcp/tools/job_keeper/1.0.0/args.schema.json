{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "registry_id"
      ]
    },
    {
      "required": [
        "job_id"
      ]
    },
    {
      "required": [
        "work_dir"
      ]
    }
  ],
  "properties": {
    "registry_id": {
      "type": "integer",
      "minimum": 1,
      "description": "캠페인 제출 응답의 registry_id"
    },
    "job_id": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]{1,12}$",
      "minimum": 1,
      "description": "캠페인 드라이버 잡의 Slurm job_id"
    },
    "work_dir": {
      "type": "string",
      "pattern": "^/.+",
      "description": "캠페인 결과 폴더 절대경로(/data/single/<사용자>/ 아래)"
    },
    "dry_run": {
      "type": "boolean",
      "default": true,
      "description": "true(기본)면 고르기만, 제출하지 않는다"
    },
    "cpus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256,
      "description": "deep 잡 CPU (기본 40)"
    },
    "mem": {
      "type": "string",
      "pattern": "^[0-9]{1,6}[MG]$",
      "description": "deep 잡 메모리 (기본 400G)"
    },
    "partition": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "파티션"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
      "description": "deep 잡 시간 (기본 04:00:00)"
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "배열 동시 수 %N (기본 20)"
    },
    "exclude": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_,\\[\\]-]{1,256}$",
      "description": "제외 노드(기본 slurmctld 호스트)"
    }
  }
}

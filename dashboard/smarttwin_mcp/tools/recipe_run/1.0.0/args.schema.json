{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,47}$",
      "description": "레시피 이름(소문자로 시작하는 [a-z0-9_] 3~48자)"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "판 번호(생략하면 쓸 수 있는 마지막 판)"
    },
    "params": {
      "type": "object",
      "description": "매개변수 값(생략하면 기본값)"
    },
    "model_path": {
      "type": "string",
      "pattern": "^/.+",
      "description": "kmm 레시피: 입력 모델(.k) 절대경로"
    },
    "target": {
      "type": "string",
      "pattern": "^/.+",
      "description": "post 레시피: 분석할 결과 폴더·파일 절대경로"
    },
    "extra_inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^/.+"
      },
      "description": "옵션이 가리키는 보조 파일 절대경로(잡 work/ 로 같이 올라간다)"
    },
    "slurm": {
      "type": "object",
      "description": "잡 자원(원래 도구와 같은 꼴)"
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "제출하지 않고 만들어질 요청만 본다"
    },
    "wait_sec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800,
      "description": "끝나기를 기다릴 최대 시간(초)"
    },
    "job_name": {
      "type": "string",
      "maxLength": 64,
      "description": "잡 이름(선택)"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kmm_drop_weight_impact_test args",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_path"
  ],
  "properties": {
    "model_path": {
      "type": "string",
      "pattern": "^/.+",
      "description": "입력 LS-DYNA 모델(.k) 절대경로. 잡 work/ 폴더로 복사돼 *Inputfile 이 된다."
    },
    "options": {
      "type": "object",
      "properties": {
        "Height": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "실수 리스트 · 기본 0.5 — 충격추 낙하 높이 → 초기 속도 √(2gh) 가 InitialVelocity 에 더해진다 (모델은 OffsetDistance 간격에 놓임). g 는 Gravity 키, 없으면 모델 재질 밀도로 단위계 판정 (ton-mm-s → 9810, kg-m-s → 9.81)"
        },
        "Gravity": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 모델 재질 밀도로 판정 — 자유낙하 g (모델 단위). 재질 밀도 중앙값 < 1e-7 → 9810, 100~1e5 → 9.81. 그 밖(kg-mm-ms·g-cm-s·g-mm-ms 등)은 WARNING 후 옛 추정 → 반드시 지정"
        },
        "Type": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "Sphere|Cylinder · 기본 Sphere — 충격추 형상"
        },
        "Dimension": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "실수 리스트 · 기본 0.008 — Sphere: 반지름. Cylinder 5값(2단): r,외곽r,앞높이,뒤높이,뒤r / 7값(3단): r,외곽r,앞높이,중간r,중간높이,뒤r,뒤높이"
        },
        "MeshSize": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 0.001 — 충격추 요소 크기"
        },
        "DimensionDamper": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "실수 리스트 · 기본 - — 댐퍼 치수 (있을 때만 댐퍼 생성)"
        },
        "tFinal": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 0 — 종료 시간"
        },
        "dt": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 1e-6 — d3plot 출력 간격"
        },
        "DTMIN": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 없음 — CONTROL_TERMINATION DTMIN"
        },
        "OffsetDistance": {
          "type": [
            "number",
            "string"
          ],
          "description": "실수 · 기본 1e-9 — 충격추와 표면 초기 간격"
        },
        "GenerationMode": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "DampingSpring|Part · 기본 DampingSpring — Part = PartIDs 파트 표면 격자에 자동 배치"
        },
        "PartIDs": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "정수 리스트 · 기본 [] — GenerationMode,Part 대상 파트"
        },
        "LocationMode": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ],
          "description": "NXM 문자열 · 기본 1X1 — 파트 표면 격자 배치 (예: 3X3 → 9 케이스)"
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "array"
        ]
      },
      "description": "블록 안 `키,값` 줄. 값이 배열이면 쉼표로 잇는다(예: [0,0,10] → 0,0,10). 아래 키 표에 없는 키(DropContact.<필드> 등)도 그대로 쓸 수 있다."
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 2000,
      "description": "블록에 그대로 넣을 원문 줄(같은 키 반복·*로 시작하는 줄·표). 사례 블록을 그대로 옮기면 된다. 빈 줄·**/*Mode/*End 줄은 넣을 수 없다."
    },
    "extra_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/.+"
      },
      "maxItems": 64,
      "description": "옵션이 가리키는 보조 파일의 절대경로. 잡 work/ 폴더로 같이 올라가므로 옵션 값에는 파일 이름만 쓰면 된다. 허용 범위: /data/single/<사용자>/, /shared/uploads/users/<사용자>/, /data/scenario/."
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "description": "잡 자원(선택). 생략하면 도구 종류별 기본(전처리 2 CPU·8G, 후처리 4 CPU·16G, 24시간)을 클러스터에서 가장 큰 노드에 맞춰 줄여 쓴다.",
      "properties": {
        "cpus_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "CPU 수"
        },
        "mem": {
          "type": "string",
          "pattern": "^[0-9]{1,6}[MG]$",
          "description": "메모리 (예: 32G)"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
          "description": "시간 상한 HH:MM:SS"
        },
        "partition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "description": "파티션 이름 (생략 = 클러스터 기본)"
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "true 면 제출하지 않고 생성될 입력 파일·명령만 돌려준다(PAT 없이도 된다). 먼저 이걸로 확인할 것."
    },
    "wait_sec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800,
      "default": 0,
      "description": "제출 후 이 시간(초) 안에 끝나면 결과(rc·로그 꼬리·작은 산출물)를 함께 돌려준다. 0 = job_id 만."
    },
    "job_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,48}$",
      "description": "잡 이름(결과 폴더 이름이 된다). 생략하면 stmc_<도구이름>."
    }
  }
}

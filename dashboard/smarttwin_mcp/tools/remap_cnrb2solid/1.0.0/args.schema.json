{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remap_cnrb2solid args",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "output"
  ],
  "properties": {
    "model": {
      "type": "string",
      "description": "입력 K-파일 (*CONSTRAINED_NODAL_RIGID_BODY 포함)",
      "x-kind": "session_file"
    },
    "output": {
      "type": "string",
      "description": "출력 K-파일 (HEX8 솔리드 요소 포함)"
    },
    "E": {
      "type": "number",
      "description": "Young의 탄성계수 [MPa]",
      "default": 200000.0
    },
    "PR": {
      "type": "number",
      "description": "Poisson 비율 (0.0~0.5)",
      "default": 0.3
    },
    "RHO": {
      "type": "number",
      "description": "재료 밀도 [t/mm³] (예: 강철 7.85e-9)",
      "default": 7.85e-09
    },
    "radius_scale": {
      "type": "number",
      "description": "링 노드 반경 = 볼트홀 반경 × 이 값 (1.0 이하로 체결 간격 유지)",
      "default": 0.999
    },
    "num_circum_nodes": {
      "type": "integer",
      "description": "원주 노드 수 (4의 배수; 0=자동 감지)",
      "default": 0
    },
    "inner_radius_ratio": {
      "type": "number",
      "description": "코어 사각형 반변 / 링 반경 비율",
      "default": 0.3
    },
    "axis_direction": {
      "type": "string",
      "description": "실린더 축 방향 (auto=PCA 자동 감지)",
      "enum": [
        "auto",
        "x",
        "y",
        "z"
      ],
      "default": "auto"
    },
    "z_tolerance": {
      "type": "number",
      "description": "Z-레벨 그룹핑 허용 오차 [mm]",
      "default": 0.1
    },
    "r_tolerance": {
      "type": "number",
      "description": "반경 클러스터링 허용 오차 [mm] (단계형 볼트용)",
      "default": 0.5
    },
    "head_offset_r": {
      "type": "number",
      "description": "볼트 헤드 반경 오프셋 [mm] (0.0=헤드 미생성)",
      "default": 0.0
    },
    "head_thickness": {
      "type": "number",
      "description": "볼트 헤드 축방향 두께 [mm]",
      "default": 2.0
    },
    "head_position": {
      "type": "string",
      "description": "헤드 위치 (auto=큰 R 또는 Z_max 쪽, none=헤드 미생성)",
      "enum": [
        "auto",
        "top",
        "bottom",
        "none"
      ],
      "default": "auto"
    },
    "flatten_includes": {
      "type": "boolean",
      "description": "Optional, default false (since 2026-10-17). When the model *INCLUDEs other files, read the whole closure flattened into one standalone deck — each *INCLUDE card replaced by its file's body in LS-DYNA reading order, the include files' *KEYWORD lines dropped — and write the result as one file without *INCLUDE. Without it the op edits only the main deck and stops with exit code 1 (naming this key) when its target parts, materials or cards live only inside an include. Refused when the closure cannot be read completely, has a cycle, or an *INCLUDE + / - or an include *KEYWORD changes the field width.",
      "default": false
    },
    "extra_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/.+"
      },
      "maxItems": 64,
      "description": "옵션이 가리키는 보조 파일의 절대경로. 잡 work/ 폴더로 같이 올라가므로 옵션 값에는 파일 이름만 쓰면 된다. 허용 범위: /data/single/<사용자>/, /shared/uploads/users/<사용자>/, /data/scenario/."
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "description": "잡 자원(선택). 생략하면 도구 종류별 기본(전처리 2 CPU·8G, 후처리 4 CPU·16G, 24시간)을 클러스터에서 가장 큰 노드에 맞춰 줄여 쓴다.",
      "properties": {
        "cpus_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "CPU 수"
        },
        "mem": {
          "type": "string",
          "pattern": "^[0-9]{1,6}[MG]$",
          "description": "메모리 (예: 32G)"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
          "description": "시간 상한 HH:MM:SS"
        },
        "partition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "description": "파티션 이름 (생략 = 클러스터 기본)"
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "true 면 제출하지 않고 생성될 입력 파일·명령만 돌려준다(PAT 없이도 된다). 먼저 이걸로 확인할 것."
    },
    "wait_sec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800,
      "default": 0,
      "description": "제출 후 이 시간(초) 안에 끝나면 결과(rc·로그 꼬리·작은 산출물)를 함께 돌려준다. 0 = job_id 만."
    },
    "job_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,48}$",
      "description": "잡 이름(결과 폴더 이름이 된다). 생략하면 stmc_<도구이름>."
    }
  }
}

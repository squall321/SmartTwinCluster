{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kmm_chain args",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_path",
    "modes"
  ],
  "properties": {
    "model_path": {
      "type": "string",
      "pattern": "^/.+",
      "description": "입력 LS-DYNA 모델(.k) 절대경로"
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "COHESIVE_BETWEEN_CONFORMAL_MESHES",
              "CONSTRAINED_NODAL_RIGIDBODY_TO_BEAM",
              "CONTACT_AUTO_DECOMPOSITION",
              "CONVERT_CNRB_TO_SOLID",
              "DECOMPOSE_K",
              "DEFEATURE_MESH",
              "DIMENSIONAL_TOLERANCE",
              "DROP_ATTITUDE",
              "DROP_WEIGHT_IMPACT_TEST",
              "DYNAIN_TO_INITIAL",
              "ELASTIC_TO_RIGID",
              "ERODING_MIN_DT",
              "FEM_TO_IGA",
              "IMPORT_MERGE_K",
              "MATERIAL_EXCHANGE",
              "MERGE_K",
              "PART_EXCHANGE",
              "PART_LOCATION_DOE",
              "PART_MORPHING",
              "PART_TRANSLATE",
              "PART_VALIDATION_SPLIT",
              "REMESH_TETRA",
              "REMOVE_DUPLICATE_TIED_CONTACTS",
              "RIGIDIFY_SMALL_DT",
              "SIMULATION_AUTOMATION",
              "THERMAL_LOAD",
              "TRANSFORM",
              "TRANSLATION_DOE",
              "VIBRATION_LOAD",
              "WARPED_PART",
              "WARPED_TO_INITIAL_STRESS_PART",
              "WEAK_COUPLING"
            ],
            "description": "KooMeshModifier 모드 이름"
          },
          "options": {
            "type": "object",
            "description": "그 모드 블록의 `키,값`"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "그 모드 블록의 원문 줄"
          }
        }
      },
      "description": "적용 순서대로. 같은 모델에 차례로 적용하고 마지막에 한 번 저장한다(출력 이름에 접미사가 순서대로 붙는다)."
    },
    "extra_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/.+"
      },
      "maxItems": 64,
      "description": "옵션이 가리키는 보조 파일의 절대경로. 잡 work/ 폴더로 같이 올라가므로 옵션 값에는 파일 이름만 쓰면 된다. 허용 범위: /data/single/<사용자>/, /shared/uploads/users/<사용자>/, /data/scenario/."
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "description": "잡 자원(선택). 생략하면 도구 종류별 기본(전처리 2 CPU·8G, 후처리 4 CPU·16G, 24시간)을 클러스터에서 가장 큰 노드에 맞춰 줄여 쓴다.",
      "properties": {
        "cpus_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "description": "CPU 수"
        },
        "mem": {
          "type": "string",
          "pattern": "^[0-9]{1,6}[MG]$",
          "description": "메모리 (예: 32G)"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
          "description": "시간 상한 HH:MM:SS"
        },
        "partition": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "description": "파티션 이름 (생략 = 클러스터 기본)"
        }
      }
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "true 면 제출하지 않고 생성될 입력 파일·명령만 돌려준다(PAT 없이도 된다). 먼저 이걸로 확인할 것."
    },
    "wait_sec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1800,
      "default": 0,
      "description": "제출 후 이 시간(초) 안에 끝나면 결과(rc·로그 꼬리·작은 산출물)를 함께 돌려준다. 0 = job_id 만."
    },
    "job_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,48}$",
      "description": "잡 이름(결과 폴더 이름이 된다). 생략하면 stmc_<도구이름>."
    }
  }
}
